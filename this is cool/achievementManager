package com.mycompany.dressup;
import java.util.ArrayList;


/**
 *
 * @author zulfa
 */
public class AchievementManager {
    private final ArrayList<Achievements> cheeses;    
    
    public AchievementManager(){
        cheeses = new ArrayList<>();
        
    }
    
    public void addAchievement(Achievements name){
        cheeses.add(name);
    }
    
    public boolean isNotUnlocked(String cheese){
        System.out.println("Checking for " + cheese + "...");
        for (Achievements name : cheeses){
            if(name.getName().equalsIgnoreCase(cheese)){
                System.out.println("User has the achievement: " + cheese);
                return false;
            }
        } 
        System.out.println("User does not have achievement: " + cheese);
        return true;
    }
    
    // displays all achievements in a list ("???" for unlocked achievements) 
    public String DisplayAllAchievements(ArrayList<Achievements> allAchievements){

    StringBuilder sb = new StringBuilder("Achievements:\n");

    for (Achievements ach : allAchievements) {
        boolean unlocked = false;
        for (Achievements unlockedAch : cheeses) {
            if (unlockedAch.getName().equalsIgnoreCase(ach.getName())) {
                unlocked = true;
                break;
            }
        }

        if (unlocked) {
            sb.append("- ").append(ach.getName()).append(": ").append(ach.getDescription()).append("\n"); // show real name
        } else {
            sb.append("- ???\n");
        }
    }
    return sb.toString();
    }

}
    

