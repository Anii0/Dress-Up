//shows 3 avatars together after it saves
private Scene buildFinishScene(Stage primaryStage) {
    Text finishTitle = new Text("You finished the game! Let's look at all your avatars!");
       finishTitle.getStyleClass().add("user-details"); 
    // HBox to show all avatars
    HBox allAvatars = new HBox(20);
    allAvatars.setAlignment(Pos.CENTER);
    allAvatars.getChildren().addAll(
        new VBox (20, displayAvatar(avatar1), avatar1Name) {{setAlignment(Pos.CENTER);}},
        new VBox (20, displayAvatar(avatar2), avatar2Name) {{setAlignment(Pos.CENTER);}},
        new VBox (20, displayAvatar(avatar3), avatar3Name) {{setAlignment(Pos.CENTER);}}
    );
    allAvatars.getStyleClass().add("user-details");

    Button quit = new Button("Quit");
    quit.setOnAction(e -> primaryStage.close());
    quit.getStyleClass().add("mainButtons"); 

    VBox finishBox = new VBox(30, finishTitle, allAvatars, quit);
    finishBox.setAlignment(Pos.CENTER);

    return new Scene(finishBox, 800, 600);
}

private StackPane displayAvatar(Avatar avatar){
    ImageView body = new ImageView(avatar.getSkinTone());
    ImageView face = new ImageView(avatar.getGender());
    ImageView shirt = new ImageView(new Image(avatar.getClothingImg("shirt")));
    ImageView pants = new ImageView(new Image(avatar.getClothingImg("pants")));
    ImageView hair = new ImageView(new Image(avatar.getClothingImg("hair")));

    StackPane display = new StackPane(body, face, pants, shirt, hair);
    return display;
}

//saves clothes
private void updateClothingImages(Avatar avatar) {
    if (avatar != null) {
        faceImg.setImage(avatar.getGender());
        bodyImgView.setImage(avatar.getSkinTone());
        shirtImg.setImage(new Image(avatar.getClothingImg("shirt")));
        pantImg.setImage(new Image(avatar.getClothingImg("pants")));
        hairImg.setImage(new Image(avatar.getClothingImg("hair")));
    }
}

private void changeGender(String gender) {
    String name = currentAvatar.getName();
    Avatar newAvatar;
    
    // creates new avatar depending on gender
    switch (gender) {
        case "boy":
            newAvatar = new Boy(name);
            break;
        case "girl":
            newAvatar = new Girl(name);
            break;
        default:
            newAvatar = new Neutral(name);
            break;
    }
    
    newAvatar.setSkinTone(currentAvatar.getSkinToneString());
    
    // Replace current avatar with new one
    switch (editingAvatarIndex) {
        case 1:
            avatar1 = newAvatar;
            currentAvatar = avatar1;
            break;
        case 2:
            avatar2 = newAvatar;
            currentAvatar = avatar2;
            break;
        default:
            avatar3 = newAvatar;
            currentAvatar = avatar3;
            break;
    }
        updateClothingImages(currentAvatar);
}
    
    
