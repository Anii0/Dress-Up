private StackPane displayAvatar(Avatar avatar){
    displayAvatar = avatar;
    ImageView body = new ImageView(displayAvatar.getSkinTone());
    ImageView face = new ImageView(displayAvatar.getGender());
    ImageView shirt = new ImageView(new Image(displayAvatar.getClothingImg("shirt")));
    ImageView pants = new ImageView(new Image(displayAvatar.getClothingImg("pants")));
    ImageView hat = new ImageView(new Image(displayAvatar.getClothingImg("hat")));
    
    StackPane display = new StackPane(body, face, shirt, pants, hat);
    return display;
}

