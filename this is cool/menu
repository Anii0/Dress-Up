        pantImg.setImage(new Image(currentAvatar.getClothingImg("pants")));
        hatImg.setImage(new Image(currentAvatar.getClothingImg("hat")));
    }
}

private void changeGender(String gender) {
    String name = currentAvatar.getName();
    Avatar newAvatar;
    
    // creates new avatar depending on gender
    switch (gender) {
        case "boy":
            newAvatar = new Boy(name);
            break;
        case "girl":
            newAvatar = new Girl(name);
            break;
        default:
            newAvatar = new Neutral(name);
            break;
    }
    
    newAvatar.setSkinTone(currentAvatar.getSkinToneString());
    
    // Replace current avatar with new one
    switch (editingAvatarIndex) {
        case 1:
            avatar1 = newAvatar;
            currentAvatar = avatar1;
            break;
        case 2:
            avatar2 = newAvatar;
            currentAvatar = avatar2;
            break;
        default:
            avatar3 = newAvatar;
            currentAvatar = avatar3;
            break;
    }
        updateClothingImages();
}
    
    
public void achievementPopup(Stage primaryStage, String achievement, String desc, Runnable nextPopup) {
    Popup popup = new Popup();
// CAN CHANGE COLOR AND FONT OF POPUP TEXT
    Text popupName = new Text(achievement);
        popupName.setStyle("-fx-font-weight: bold;");
    Text popupDesc = new Text(desc);

    VBox popupText = new VBox(popupName, popupDesc);

// EDIT THIS BELOW TO STYLE ACHIVEMENT POPUP
    popupText.setStyle("-fx-background-color: white; -fx-padding: 10; -fx-border-color: black;");
    popup.getContent().add(popupText);

// EDIT WHERE IT SHOWS UP
    popup.show(primaryStage, primaryStage.getX() + 200, primaryStage.getY() + 100);

    PauseTransition hideTimer = new PauseTransition(Duration.seconds(1.5));
    hideTimer.setOnFinished(e -> {
        popup.hide();
        if (nextPopup != null) {
            nextPopup.run();  // run next popup if there is one
        }});
    hideTimer.playFromStart();

}

public void unlockAchievements() { // unlocks achievements that needs to be unlocked after pressing a done button
    // Unlock achievement 1 (right when a done is pressed; doesnt matter which one)
    if (cheese.isNotUnlocked(one.getName())) {
        cheese.addAchievement(one);
        achiOne = true;
    }

    // Unlock achievement 2 (when all three done's have been clicked)
    if (done1B && done2B && done3B) {
        if (cheese.isNotUnlocked(two.getName())) {
            cheese.addAchievement(two);
            achiTwo = true;
        }
    }

    // Unlock achievement 3 (hatsune miku easter egg)
    if (currentAvatar.getClothingImg("shirt").contains("G-top-6") &&
        currentAvatar.getClothingImg("pants").contains("G-pant-5") &&
        currentAvatar.getClothingImg("hat").contains("G-hair-1")) {

        if (cheese.isNotUnlocked(three.getName())) {
            cheese.addAchievement(three);
            achiThree = true;
        }
    }

    // Unlock achievement 4 (kim dokja easter egg)
    if (currentAvatar.getClothingImg("shirt").contains("B-top-7") &&
        currentAvatar.getClothingImg("pants").contains("B-pant-7") &&
        currentAvatar.getClothingImg("hat").contains("B-hair-4")) {

        if (cheese.isNotUnlocked(four.getName())) {
            cheese.addAchievement(four);
            achiFour = true;
        }
    }
}

// shows popups when you get an achievement
// if two are earned at the same time, shows them one after another
public void showAchievements(Stage primaryStage) {
    if (achiOne && achiThree) {
        achievementPopup(primaryStage, one.getName(), one.getDescription(), () -> {
            achievementPopup(primaryStage, three.getName(), three.getDescription(), null);
        });
    } else if (achiOne && achiFour) {
        achievementPopup(primaryStage, one.getName(), one.getDescription(), () -> {
            achievementPopup(primaryStage, four.getName(), four.getDescription(), null);
        });
    } else if (achiTwo && achiThree) {
        achievementPopup(primaryStage, two.getName(), two.getDescription(), () -> {
            achievementPopup(primaryStage, three.getName(), three.getDescription(), null);
        });
    } else if (achiTwo && achiFour) {
        achievementPopup(primaryStage, two.getName(), two.getDescription(), () -> {
            achievementPopup(primaryStage, four.getName(), four.getDescription(), null);
        });
    } else if (achiOne) {
        achievementPopup(primaryStage, one.getName(), one.getDescription(), null);
    } else if (achiTwo) {
        achievementPopup(primaryStage, two.getName(), two.getDescription(), null);
    } else if (achiThree) {
        achievementPopup(primaryStage, three.getName(), three.getDescription(), null);
    } else if (achiFour) {
        achievementPopup(primaryStage, four.getName(), four.getDescription(), null);
    }
    
    achiOne = false;
    achiTwo = false;
    achiThree = false;
    achiFour = false;
    
}

