public class Avatar {
    private HashMap<String, String[]> clothingOptions;
    private HashMap<String, Integer> clothingIndex;
    private String name;

    public Avatar(String name) {
        this.name = name;
        clothingOptions = new HashMap<>();
        clothingIndex = new HashMap<>();

        // Clothing options
        clothingOptions.put("shirt", new String[]{"Red Shirt", "Blue Shirt", "Green Shirt"});
        clothingOptions.put("pants", new String[]{"Jeans", "Shorts", "Black Pants"});
        clothingOptions.put("hat", new String[]{"Cap", "Beanie", "Cowboy Hat"});

        // Default to first clothing item
        clothingIndex.put("shirt", 0);
        clothingIndex.put("pants", 0);
        clothingIndex.put("hat", 0);
    }

    public void nextClothing(String type) {
        int currentIndex = clothingIndex.get(type);
        int newIndex = (currentIndex + 1) % clothingOptions.get(type).length;
        clothingIndex.put(type, newIndex);
    }

    public void previousClothing(String type) {
        int currentIndex = clothingIndex.get(type);
        int newIndex = (currentIndex - 1 + clothingOptions.get(type).length) % clothingOptions.get(type).length;
        clothingIndex.put(type, newIndex);
    }

    public String getClothingText() {
        return "Shirt: " + clothingOptions.get("shirt")[clothingIndex.get("shirt")] + ", " +
               "Pants: " + clothingOptions.get("pants")[clothingIndex.get("pants")] + ", " +
               "Hat: " + clothingOptions.get("hat")[clothingIndex.get("hat")];
    }

    public String getName() {
        return name;
    }
}

