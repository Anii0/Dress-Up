    //saves clothes
    private void updateClothingImages() {
    if (currentAvatar != null) {
        bodyImgView.setImage(currentAvatar.getBodyType());
        shirtImg.setImage(new Image(currentAvatar.getClothingImg("shirt")));
        pantImg.setImage(new Image(currentAvatar.getClothingImg("pants")));
